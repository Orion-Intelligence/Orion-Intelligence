{
  "manifest_version": 3,
  "name": "Orion Social Scraper",
  "description": "Browser-assisted social scraping executor for Orion.",
  "version": "0.2.6",
  "action": {
    "default_popup": "index.html",
    "default_title": "Orion Social Scraper",
    "default_icon": {
      "16": "assets/images/icon-16.png",
      "32": "assets/images/icon-32.png",
      "48": "assets/images/icon-48.png",
      "128": "assets/images/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/images/icon-16.png",
    "32": "assets/images/icon-32.png",
    "48": "assets/images/icon-48.png",
    "128": "assets/images/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "alarms",
    "cookies",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/core/orion-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "assets/core/orion-service.js"
  }
}
