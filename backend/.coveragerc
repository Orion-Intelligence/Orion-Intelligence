[run]
branch = True
parallel = True
sigterm = True
source =
    /app
omit =
    */site-packages/*
    */__pycache__/*
    */.venv/*
    */venv/*
    /app/migrations/*
    /app/static/*
    /app/build/*
    /app/docs/*
    /app/bloom_data/*
    /app/cronjobs.py
    /app/client/*
    client/*
    **/*.html
    **/*.css
    **/*.scss
    **/*.js
    **/*.ts
    **/*.json
    **/*.md
    **/*.sh
    **/*.yaml
    **/*.yml
    */node_modules/*
    */.nyc_output/*
    */coverage/*
    */cypress/*
    */cypress.config.*
    */angular.json
    */package.json
    */package-lock.json
    */proxy.conf.json
    */post-build.js
    */webpack*.js
    */tsconfig*.json

[paths]
source =
    backend/
    /app/

[report]
show_missing = True
skip_empty = True
exclude_lines =
    logger\.error
    logger\.exception
