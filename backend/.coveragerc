[run]
branch = True
parallel = True
sigterm = True
source =
    backend
    /app
omit =
    */site-packages/*
    backend/migrations/*
    backend/static/*
    backend/build/*
    backend/docs/*
    backend/bloom_data/*
    backend/__pycache__/*
    backend/cronjobs.py
    /app/migrations/*
    /app/static/*
    /app/build/*
    /app/docs/*
    /app/bloom_data/*
    /app/__pycache__/*
    /app/cronjobs.py

[paths]
source =
    backend/
    /app/

[report]
show_missing = True
skip_empty = True
exclude_lines =
    logger\.error
    logger\.exception
