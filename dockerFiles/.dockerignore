# Ignore Python cache and envs
__pycache__/
*.py[cod]
*.egg-info
.venv
venv/
.env

# Ignore node modules
node_modules/
client/node_modules/

# Ignore build outputs
dist/
build/
client/dist/
client/build/

# Ignore generated coverage output
client/.nyc_output/
client/coverage/
backend/coverage.xml
backend/htmlcov/
coverage-merged/

# Ignore Git and OS junk
.git
.gitignore
*.log
.DS_Store
