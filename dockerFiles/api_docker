# Use a lightweight Python image
FROM python:3.11-slim AS base

# Set the working directory inside the container
WORKDIR /app

# Disable output buffering so logs print immediately
ENV PYTHONUNBUFFERED=1

# Install system dependencies (cached)
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    libblas-dev \
    liblapack-dev \
    gfortran \
    curl \
    --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Copy only requirements first (to cache dependencies)
COPY app/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip && pip install --no-cache-dir -r /tmp/requirements.txt

# Now copy the full app (this ensures dependencies are cached separately)
COPY app/ /app/

# Ensure uvicorn is in $PATH
RUN ln -s /usr/local/bin/uvicorn /usr/bin/uvicorn

# Expose the FastAPI application port
EXPOSE 8070

# Run FastAPI with live reload
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8070", "--reload", "--log-level", "debug"]
