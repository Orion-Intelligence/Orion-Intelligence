{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Trusted Web API",
    "description": "API documentation for directory, insight, and search endpoints."
  },
  "host": "orion.whistleaks.com",
  "schemes": ["https"],
  "basePath": "/",
  "paths": {
    "/api/directory/": {
      "get": {
        "operationId": "directory",
        "summary": "Get Directory",
        "description": "Retrieve the list of existing onion URLs being monitored by this system, with pagination.",
        "parameters": [
          {
            "name": "content_type",
            "in": "query",
            "required": false,
            "description": "Filter directories by specific content type.",
            "type": "string",
            "enum": [
              "all",
              "general",
              "forums",
              "news",
              "stolen",
              "drugs",
              "hacking",
              "marketplaces",
              "cryptocurrency",
              "leaks",
              "adult"
            ],
            "default": "all"
          },
          {
            "name": "index",
            "in": "query",
            "required": false,
            "description": "Filter directories by a specific index string.",
            "type": "string",
            "enum": [
              "all",
              "general",
              "monitor"
            ],
            "default": "all"
          },
          {
            "name": "network",
            "in": "query",
            "required": false,
            "description": "Filter directories by a specific network.",
            "type": "string",
            "enum": [
              "all",
              "onion",
              "i2p",
              "clearnet"
            ],
            "default": "all"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "schema": {
              "$ref": "#/definitions/DirectoryResponse"
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/insight/": {
      "get": {
        "operationId": "insight",
        "summary": "Retrieve System Insights",
        "description": "Provides a detailed summary of the system, including total documents, URLs, and other statistical insights.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Successful response containing system insights.",
            "schema": {
              "$ref": "#/definitions/InsightResponse"
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/search/": {
      "get": {
        "operationId": "search",
        "summary": "Search API",
        "description": "Fetches content matching specific search parameters.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query string.",
            "type": "string"
          },
          {
            "name": "mSearchParamSafeSearch",
            "in": "query",
            "required": false,
            "description": "Safe search filter.",
            "type": "boolean",
            "default": false
          },
          {
            "name": "mSearchParamPage",
            "in": "query",
            "required": false,
            "description": "Pagination page number.",
            "type": "integer",
            "default": 1
          },
          {
            "name": "pSearchParamType",
            "in": "query",
            "required": false,
            "description": "Filter results by specific search parameter type.",
            "type": "string",
            "enum": [
              "monitor",
              "general",
              "forums",
              "news",
              "stolen",
              "drugs",
              "hacking",
              "marketplaces",
              "cryptocurrency",
              "leaks",
              "adult"
            ]
          },
          {
            "name": "mNetwork",
            "in": "query",
            "required": false,
            "description": "Filter results by specific network.",
            "type": "string",
            "enum": [
              "onion",
              "i2p",
              "clearnet"
            ],
            "default": "all"
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/SearchResponse"
            }
          },
          "401": {
            "description": "Authentication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DirectoryResponse": {
      "type": "object",
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Directory"
          }
        },
        "page": {
          "type": "integer",
          "description": "Current page number"
        },
        "size": {
          "type": "integer",
          "description": "Number of items per page"
        },
        "total": {
          "type": "integer",
          "description": "Total number of directories available"
        }
      }
    },
    "Directory": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "description": "Unique identifier for the directory entry"
        },
        "url": {
          "type": "string",
          "description": "Onion URL being monitored"
        },
        "content_type": {
          "type": "array",
          "description": "Content types associated with the URL",
          "items": {
            "type": "string"
          }
        },
        "url_status_date": {
          "type": "integer",
          "description": "Timestamp of the URL status update"
        },
        "leak_status_date": {
          "type": "integer",
          "description": "Timestamp of the leak status update"
        }
      }
    },
    "InsightResponse": {
      "type": "object",
      "properties": {
        "generic_model": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GenericModel"
          }
        },
        "leak_model": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LeakModel"
          }
        }
      }
    },
    "GenericModel": {
      "type": "object",
      "properties": {
        "Document Count": {
          "type": "integer"
        },
        "Most Recent": {
          "type": "string",
          "format": "date"
        },
        "Oldest Update": {
          "type": "string",
          "format": "date"
        },
        "Updated 5 Days ago": {
          "type": "integer"
        },
        "Average Score": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "LeakModel": {
      "type": "object",
      "properties": {
        "Document Count": {
          "type": "integer"
        },
        "Most Recent": {
          "type": "string",
          "format": "date"
        },
        "Oldest Update": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "SearchResponse": {
      "type": "object",
      "properties": {
        "Result": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchResult"
          }
        }
      }
    },
    "SearchResult": {
      "type": "object",
      "properties": {
        "m_base_url": {
          "type": "string"
        },
        "m_url": {
          "type": "string"
        },
        "m_title": {
          "type": "string"
        },
        "m_meta_description": {
          "type": "string"
        },
        "m_content": {
          "type": "string"
        },
        "m_important_content": {
          "type": "string"
        },
        "m_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "m_sub_url": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "m_validity_score": {
          "type": "integer"
        },
        "m_content_type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "m_update_date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      }
    }
  }
}
