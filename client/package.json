{
  "name": "client",
  "version": "0.0.0",
  "packageManager": "npm@11.12.0",
  "scripts": {
    "ng": "node --disable-warning=DEP0060 ./node_modules/@angular/cli/bin/ng",
    "prebuild": "node -e \"\"",
    "build": "npm run prebuild && NO_COLOR=1 NG_BUILD_MAX_ERRORS=1000 ng build --configuration=production && node post-build.js",
    "production": "npm run prebuild && NO_COLOR=1 NG_BUILD_MAX_ERRORS=1000 ng build --configuration=production && node post-build.js",
    "test": "cypress",
    "lint": "npm run lint:styles && npx eslint src/app --ext .ts,.html --max-warnings=1000",
    "lint:styles": "npx stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "npx eslint src/app --ext .ts,.html --fix",
    "lint:watch": "npx eslint src/app --ext .ts,.html --watch",
    "serve": "node --disable-warning=DEP0060 ./node_modules/@angular/cli/bin/ng serve",
    "serve:watch": "node --disable-warning=DEP0060 ./node_modules/@angular/cli/bin/ng serve"
  },
  "private": true,
