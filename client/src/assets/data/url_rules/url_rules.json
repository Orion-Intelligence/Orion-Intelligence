{
  "defacement": {
    "rule_type": "unique",
    "path": "defacement_collector"
  },
  "exploit": {
    "rule_type": "unique",
    "path": "exploit_collector"
  },
  "forum": {
    "rule_type": "unique",
    "path": "social/forum"
  },
  "generic": {
    "rule_type": "generic",
    "path": null,
    "value_regex": "^(?:https?://)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+(?:[a-z]{2,63}|onion|i2p)/?$"
  },
  "leak": {
    "rule_type": "unique",
    "path": "leak_collector/leak"
  },
  "apt": {
    "rule_type": "unique",
    "path": "malware_collector"
  },
  "malware": {
    "rule_type": "unique",
    "path": "malware_collector/scripts"
  },
  "news": {
    "rule_type": "unique",
    "path": "news_collector"
  },
  "pastebin": {
    "rule_type": "shared",
    "path": "social/platform",
    "value_regex": "^https?://(?:[^/]+\\.)?pastebin\\.com(?:/.*)?$"
  },
  "tracking": {
    "rule_type": "unique",
    "path": "leak_collector/tracking"
  },
  "blogger": {
    "rule_type": "shared",
    "path": "social/platform",
    "value_regex": "^https?://(?:(?:[^/]+\\.)?blogspot\\.com|(?:[^/]+\\.)?blogger\\.com|blog\\.malwaremustdie\\.org)(?:/.*)?$"
  },
  "bluesky": {
    "rule_type": "shared",
    "path": "social/platform",
    "value_regex": "^https?://(?:bsky\\.app/(?:profile/[^/?#]+(?:/.*)?|search\\?q=[^&#]+(?:&.*)?)|(?:[^/]+\\.)?bsky\\.social(?:/.*)?)$"
  },
