{
  "defacement": {
    "rule_type": "unique",
    "path": "defacement_collector"
  },
  "exploit": {
    "rule_type": "unique",
    "path": "exploit_collector"
  },
  "forum": {
    "rule_type": "unique",
    "path": "social/forum"
  },
  "generic": {
    "rule_type": "generic",
    "path": null,
    "value_regex": "^https?://(?:[a-z0-9-]+\\.)*[a-z2-7]{16,56}\\.onion(?:/.*)?$"
  },
  "leak": {
    "rule_type": "unique",
    "path": "leak_collector/leak"
  },
  "mastodon": {
    "rule_type": "shared",
    "path": "social/platform",
    "value_regex": "^https?://[^/]+/@[^/]+(?:/.*)?$"
  },
  "news": {
    "rule_type": "unique",
    "path": "news_collector"
  },
  "pastebin": {
    "rule_type": "shared",
    "path": "social/platform",
    "value_regex": "^https?://(?:[^/]+\\.)?pastebin\\.com(?:/.*)?$"
  },
  "reddit": {
    "rule_type": "shared",
    "path": "social/platform",
    "value_regex": "^https?://(?:[^/]+\\.)?reddittorjg6rue252oqsxryoxengawnmo46qy4kyii5wtqnwfj4ooad\\.onion(?:/.*)?$"
  },
  "tracking": {
    "rule_type": "unique",
    "path": "leak_collector/tracking"
  },
  "twitter": {
    "rule_type": "shared",
    "path": "social/platform",
    "value_regex": "^https?://(?:www\\.)?x\\.com(?:/.*)?$"
  }
}
